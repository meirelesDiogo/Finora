// Prisma 7: a URL de conexão fica em prisma.config.ts.
// Prisma 6 ou anterior: adicione  url = env("DATABASE_URL")  dentro de datasource.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  TRANSFER
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  avatar       String?
  currency     String   @default("BRL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  projects      Project[]
  budgets       Budget[]
  goals         Goal[]
  contributions GoalContribution[]
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType @default(CHECKING)
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  currentBalance Decimal     @default(0) @db.Decimal(14, 2)
  color          String?
  icon           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  color     String?
  icon      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model Project {
  id           String    @id @default(cuid())
  userId       String
  name         String
  description  String?
  targetAmount Decimal?  @db.Decimal(14, 2)
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  color        String?
  icon         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  accountId     String
  categoryId    String
  projectId     String?
  type          TransactionType
  amount        Decimal         @db.Decimal(14, 2)
  description   String
  date          DateTime        @db.Date
  paymentMethod PaymentMethod   @default(OTHER)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([userId, projectId])
  @@index([accountId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      Int      @db.SmallInt
  year       Int
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  description   String?
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @db.Decimal(14, 2)
  deadline      DateTime? @db.Date
  color         String?
  icon          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id        String   @id @default(cuid())
  userId    String
  goalId    String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
  @@index([userId])
}
