generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model usuarios {
  cod_usuario   BigInt       @id @default(autoincrement())
  email         String       @unique @db.VarChar(255)
  senha         String       @db.VarChar(255)
  data_criacao  DateTime     @default(now()) @db.Timestamp(6)
  categorias    categorias[]
  projetos      projetos[]
  lancamentos   lancamentos[]
  ativos_investimento ativos_investimento[]
  operacoes_investimento operacoes_investimento[]

  @@map("usuarios")
}

model categorias {
  cod_categoria BigInt       @id @default(autoincrement())
  cod_usuario   BigInt
  nome          String       @db.VarChar(100)
  tipo          String       @db.VarChar(10)
  usuario       usuarios     @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade)
  lancamentos   lancamentos[]

  @@unique([cod_usuario, cod_categoria])
  @@unique([cod_usuario, nome, tipo])
  @@map("categorias")
}

model projetos {
  cod_projeto  BigInt       @id @default(autoincrement())
  cod_usuario  BigInt
  nome         String       @db.VarChar(150)
  descricao    String?      @db.Text
  data_criacao DateTime     @default(now()) @db.Timestamp(6)
  usuario      usuarios    @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade)
  lancamentos  lancamentos[]

  @@unique([cod_usuario, cod_projeto])
  @@unique([cod_usuario, nome])
  @@map("projetos")
}

model lancamentos {
  cod_lancamento BigInt      @id @default(autoincrement())
  cod_usuario    BigInt
  cod_categoria  BigInt
  cod_projeto    BigInt?
  descricao      String      @db.VarChar(255)
  valor          Decimal     @db.Decimal(12, 2)
  tipo           String      @db.VarChar(10)
  data_lancamento DateTime   @db.Date
  data_criacao   DateTime    @default(now()) @db.Timestamp(6)
  usuario        usuarios    @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade)
  categoria      categorias  @relation(fields: [cod_usuario, cod_categoria], references: [cod_usuario, cod_categoria])
  projeto        projetos?   @relation(fields: [cod_usuario, cod_projeto], references: [cod_usuario, cod_projeto])

  @@index([cod_usuario, data_lancamento])
  @@index([cod_usuario, cod_projeto])
  @@index([cod_usuario, cod_categoria])
  @@index([cod_usuario, tipo])
  @@map("lancamentos")
}

model ativos_investimento {
  cod_ativo       BigInt       @id @default(autoincrement())
  cod_usuario     BigInt
  nome            String       @db.VarChar(150)
  tipo            String       @db.VarChar(30)
  ticker          String?      @db.VarChar(20)
  moeda           String       @default("BRL") @db.VarChar(10)
  percentual_cdi  Decimal?     @db.Decimal(8, 3)
  taxa_anual      Decimal?     @db.Decimal(8, 4)
  data_aplicacao  DateTime?    @db.Date
  data_vencimento DateTime?    @db.Date
  cotacao_atual   Decimal      @default(0) @db.Decimal(18, 8)
  cambio_brl      Decimal      @default(1) @db.Decimal(18, 8)
  saldo_atual     Decimal      @default(0) @db.Decimal(18, 2)
  data_criacao    DateTime     @default(now()) @db.Timestamp(6)
  usuario         usuarios     @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade)
  operacoes       operacoes_investimento[]

  @@unique([cod_usuario, cod_ativo])
  @@index([cod_usuario, tipo])
  @@map("ativos_investimento")
}

model operacoes_investimento {
  cod_operacao   BigInt             @id @default(autoincrement())
  cod_usuario    BigInt
  cod_ativo      BigInt
  tipo           String             @db.VarChar(10)
  quantidade     Decimal            @db.Decimal(20, 8)
  preco_unitario Decimal            @db.Decimal(18, 8)
  cambio_brl     Decimal            @default(1) @db.Decimal(18, 8)
  custos         Decimal            @default(0) @db.Decimal(14, 2)
  data_operacao  DateTime           @db.Date
  descricao      String?            @db.VarChar(255)
  data_criacao   DateTime           @default(now()) @db.Timestamp(6)
  usuario        usuarios           @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade)
  ativo          ativos_investimento @relation(fields: [cod_usuario, cod_ativo], references: [cod_usuario, cod_ativo], onDelete: Cascade)

  @@index([cod_usuario, cod_ativo, data_operacao])
  @@map("operacoes_investimento")
}
