generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categorias {
  cod_categoria BigInt        @id @default(autoincrement())
  cod_usuario   BigInt
  nome          String        @db.VarChar(100)
  tipo          String        @db.VarChar(10)
  usuarios      usuarios      @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_categoria_usuario")
  lancamentos   lancamentos[]

  @@unique([cod_usuario, nome, tipo], map: "uq_categoria_nome_tipo")
  @@unique([cod_usuario, cod_categoria], map: "uq_categoria_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model lancamentos {
  cod_lancamento  BigInt     @id @default(autoincrement())
  cod_usuario     BigInt
  cod_categoria   BigInt
  cod_projeto     BigInt?
  descricao       String     @db.VarChar(255)
  valor           Decimal    @db.Decimal(12, 2)
  tipo            String     @db.VarChar(10)
  data_lancamento DateTime   @db.Date
  data_criacao    DateTime   @default(now()) @db.Timestamp(6)
  categorias      categorias @relation(fields: [cod_usuario, cod_categoria], references: [cod_usuario, cod_categoria], onDelete: NoAction, onUpdate: NoAction, map: "fk_lancamento_categoria")
  projetos        projetos?  @relation(fields: [cod_usuario, cod_projeto], references: [cod_usuario, cod_projeto], onDelete: NoAction, onUpdate: NoAction, map: "fk_lancamento_projeto")
  usuarios        usuarios   @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_lancamento_usuario")

  @@index([cod_usuario, cod_categoria], map: "idx_lancamentos_categoria")
  @@index([cod_usuario, cod_projeto], map: "idx_lancamentos_projeto")
  @@index([cod_usuario, tipo], map: "idx_lancamentos_tipo")
  @@index([cod_usuario, data_lancamento], map: "idx_lancamentos_usuario_data")
}

model projetos {
  cod_projeto  BigInt        @id @default(autoincrement())
  cod_usuario  BigInt
  nome         String        @db.VarChar(150)
  descricao    String?
  data_criacao DateTime      @default(now()) @db.Timestamp(6)
  lancamentos  lancamentos[]
  usuarios     usuarios      @relation(fields: [cod_usuario], references: [cod_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_projeto_usuario")

  @@unique([cod_usuario, nome], map: "uq_projeto_nome")
  @@unique([cod_usuario, cod_projeto], map: "uq_projeto_usuario")
}

model usuarios {
  cod_usuario  BigInt        @id @default(autoincrement())
  email        String        @unique @db.VarChar(255)
  senha        String        @db.VarChar(255)
  data_criacao DateTime      @default(now()) @db.Timestamp(6)
  categorias   categorias[]
  lancamentos  lancamentos[]
  projetos     projetos[]
}
